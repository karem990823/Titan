# Este archivo va en la RAÍZ del proyecto (junto a docker-compose.yml).
# Docker Compose lo lee automáticamente para resolver las variables ${...}
# usadas dentro de docker-compose.yml.
#
# Copiar como ".env" y completar con valores reales. NUNCA subir el ".env" real.

DB_NAME=titan
DB_USER=titan_user
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root
