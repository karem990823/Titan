# Copiar como ".env" en esta misma carpeta (junto a docker-compose.yml).
# NUNCA subir el ".env" real — ya está cubierto por el .gitignore de la raíz.
#
# Usa los mismos valores que le pongas a be/.env (DB_USER/DB_PASSWORD), para que
# el backend corriendo fuera de Docker (DB_HOST=localhost) pueda conectarse.

DB_NAME=titan
DB_USER=titan_user
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root
