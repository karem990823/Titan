# Copiar como ".env" (junto a main.py). NUNCA subir el ".env" real.
#
# DB_HOST se sobreescribe automáticamente a "db" cuando corres con docker compose
# (ver el bloque "environment" del servicio "be" en docker-compose.yml). El valor
# de aquí abajo solo aplica cuando corres el backend directamente en tu máquina.
#
# DB_NAME / DB_USER / DB_PASSWORD deben coincidir con los del ".env" de la raíz
# del proyecto, ya que ese archivo es el que usa docker compose para crear el
# usuario y la base de datos en el contenedor de MySQL.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=titan
DB_USER=titan_user
DB_PASSWORD=changeme

# Genera un valor propio (nunca reutilices este placeholder): python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme_generate_your_own_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Carpeta (relativa al working dir del backend) donde se guardan los documentos subidos.
UPLOADS_DIR=uploads
